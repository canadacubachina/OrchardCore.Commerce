@using Microsoft.AspNetCore.Mvc.Routing
@using OrchardCore.Commerce.Abstractions.Abstractions
@using OrchardCore.Commerce.Abstractions.ViewModels

@{
    var line = (ShoppingCartLineViewModel)Model.Line;
    var attributes = (IList<(IProductAttributeValue Value, string Type, int Index)>)Model.ProductAttributes;

    // Unique ID for ARIA
    var productId = $"cart-product-{line.Product.ContentItem.ContentItemId}";
}

<div class="cart-product-name">
    <a href="@Url.DisplayContentItem(line.Product.ContentItem.ContentItemId)"
       class="link-primary"
       aria-labelledby="@productId">
        <span id="@productId">@line.ProductName</span>
    </a>
</div>

@if (line.Attributes?.Any() == true)
{
    <ul class="cart-product-attributes list-inline"
        role="list"
        aria-label="@T["Product attributes"]">

        @foreach (var (attribute, type, _) in attributes)
        {
            <shape tag="li"
                   Type="@type"
                   prop-product="@line.Product.ContentItem"
                   prop-attribute="@(attribute)" />
        }
    </ul>
}
